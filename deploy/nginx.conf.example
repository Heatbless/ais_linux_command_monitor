# Install only after replacing the name/certificate paths and reviewing locally.
server {
    listen 443 ssl;
    server_name ingest.example.invalid;
    ssl_certificate /etc/letsencrypt/live/ingest.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ingest.example.invalid/privkey.pem;
    client_max_body_size 1m;
    # Access logs omit authorization and request bodies. No UI route is proxied.
    location ~ ^/api/v1/(agent-runs|heartbeat|events)$ {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host ingest.example.invalid;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
