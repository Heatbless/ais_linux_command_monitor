# Generate fresh independent secrets using: ais-server secrets
# chmod 600 the real environment and agent credential files.
AIS_SERVER_SECRET=REPLACE_WITH_GENERATED_SECRET
AIS_OPERATOR_TOKEN=REPLACE_WITH_DIFFERENT_GENERATED_SECRET
AIS_OPERATOR_ORIGIN=http://127.0.0.1:8000
AIS_ALLOWED_HOSTS=127.0.0.1,localhost,ingest.example.invalid
# Optional additional private listener, detected on startup:
# AIS_TAILSCALE_IP=auto
